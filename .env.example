NEUROVECTOR_HOST=0.0.0.0
NEUROVECTOR_PORT=8082

# 백엔드 API
NEUROVECTOR_BACKEND_BASE_URL=http://localhost:8081
NEUROVECTOR_BACKEND_TIMEOUT_SECONDS=5.0

# 모델 설정 (YOLO26)
NEUROVECTOR_MODEL_PATH=yolo26n.pt
NEUROVECTOR_FACE_MODEL_PATH=yolo26n-pose.pt
NEUROVECTOR_DEPTH_MODEL_PATH=yolo26n-depth.pt
# auto: CUDA 사용 가능 시 GPU, 아니면 CPU. 직접 지정: 0, cpu
NEUROVECTOR_DEVICE=auto
NEUROVECTOR_CONFIDENCE_THRESHOLD=0.35
NEUROVECTOR_IOU_THRESHOLD=0.45
# 단안 깊이 모델 (YOLO26-depth)
NEUROVECTOR_DEPTH_ENABLED=true
NEUROVECTOR_DEPTH_IMGSZ=768
NEUROVECTOR_DEPTH_MIN_M=0.05
NEUROVECTOR_DEPTH_MAX_M=150.0
NEUROVECTOR_DEPTH_SCALE=1.0

# 얼굴 키포인트 거리 (근거리)
NEUROVECTOR_FACE_IPD_M=0.063
NEUROVECTOR_FACE_HEAD_WIDTH_M=0.15
NEUROVECTOR_FACE_KEYPOINT_CONFIDENCE=0.5
NEUROVECTOR_FACE_MIN_EYE_DISTANCE_PX=8.0
# YOLO26-pose 키포인트로 몸통/팔/손/다리/발까지 감지
NEUROVECTOR_BODY_PARTS_ENABLED=true
# UI에서 보정하면 표시되는 값. 비워두면 focal × IPD 로 계산.
# NEUROVECTOR_FACE_IPD_SCALE_PX_M=

# 체커보드 캘리브레이션 JSON (tools/calibrate_camera.py)
NEUROVECTOR_CAMERA_CALIBRATION_PATH=camera_calibration.json

# 감지 우선순위 덮어쓰기 (기본: 얼굴/신체/동물=1, 차량/사물=2, 나뭇잎=3)
# JSON: {"leaf": 3, "my-obstacle": 1}
NEUROVECTOR_PRIORITY_LEVELS={}

# 단안 거리 추정 (카메라 캘리브레이션)
NEUROVECTOR_CAMERA_HORIZONTAL_FOV_DEG=70.0
# 실제 픽셀 초점 거리를 알고 있으면 설정하세요. 비워두면 FOV 로 계산합니다.
# NEUROVECTOR_CAMERA_FOCAL_LENGTH_PX=
# 너비/높이 추정값이 이 비율보다 어긋나면 신뢰할 수 없는 거리로 보고 버립니다.
NEUROVECTOR_DISTANCE_MIN_AXIS_AGREEMENT=0.6
# 화면 경계에서 이 비율 안쪽에 닿은 바운딩 박스는 잘린 것으로 봅니다.
NEUROVECTOR_DISTANCE_EDGE_MARGIN_RATIO=0.02
# 클래스별 실제 크기(미터) JSON. 기본 표에 없는 파인튜닝 클래스도 여기에 추가.
# NEUROVECTOR_OBJECT_SIZES={"fallen_tree":{"width_m":3.0,"height_m":1.0}}

# 드론 식별자
NEUROVECTOR_DRONE_ID=drone-001
